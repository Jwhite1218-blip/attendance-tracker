# Server-only Netlify Function settings. Never prefix these with VITE_.
ATTENDANCE_ACCESS_CODES_JSON={"0000":{"role":"admin","displayName":"Example Admin","canManageRoster":true,"canManageBlackouts":true}}
ATTENDANCE_SESSION_SECRET=replace-with-a-long-random-secret

# Keep "blobs" during rollout. Change to "supabase" only after the private
# Supabase settings below are configured and the migration has been verified.
ATTENDANCE_STATE_BACKEND=blobs
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=replace-with-a-server-only-secret
SUPABASE_DISTRICT_SLUG=warren-township
