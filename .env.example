# Server-only Netlify Function settings. Never prefix these with VITE_.
ATTENDANCE_ACCESS_CODES_JSON={"0000":{"role":"admin","displayName":"Example Admin","canManageRoster":true,"canManageBlackouts":true}}
ATTENDANCE_SESSION_SECRET=replace-with-a-long-random-secret
# Optional targeted Liz credential rotation. When set, the original Liz access
# entry is replaced at runtime and existing Liz sessions are rejected.
ATTENDANCE_LIZ_EMPLOYEE_ID=1480724
ATTENDANCE_LIZ_REPLACEMENT_PIN=
# Optional additive four-digit credential for the restricted Chef profile.
ATTENDANCE_CHEF_PIN=

# Clone-only presentation pilots are added through this separate mapping. The
# server assigns the existing restricted district-manager permissions; only
# PIN-to-display-name pairs belong in the secret JSON. Never add temporary PINs
# to source control or the live Netlify project.
ATTENDANCE_RECOGNITION_PILOT_PINS_JSON=

# Netlify Blobs is suitable for isolated/local and single-writer testing only.
# Use "supabase" for a multi-user deployment; Blobs is last-write-wins and does
# not provide the concurrency guarantees required by shared attendance edits.
ATTENDANCE_STATE_BACKEND=blobs

# End-of-day attendance email. Keep disabled on test clones. Netlify Scheduled
# Functions use UTC, while the handler enforces the configured local time zone.
ATTENDANCE_REPORT_ENABLED=false
ATTENDANCE_REPORT_TO=liz@example.com
ATTENDANCE_REPORT_FROM=Attendance Tracker <reports@example.com>
ATTENDANCE_REPORT_SITE_URL=https://allstartracker.netlify.app
ATTENDANCE_REPORT_TIME_ZONE=America/Indiana/Indianapolis
ATTENDANCE_REPORT_HOUR=17
RESEND_API_KEY=re_replace_with_a_sending_only_key
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=replace-with-a-server-only-secret
SUPABASE_DISTRICT_SLUG=warren-township

# Optional public link to the separate Professional Standards tool. Leave
# unset until Liz provides and approves the destination URL.
VITE_PROFESSIONAL_STANDARDS_URL=

# Optional non-production banner. Leave unset in production.
VITE_TEST_ENVIRONMENT_LABEL=
