# Server-only Netlify Function settings. Never prefix these with VITE_.
ATTENDANCE_ACCESS_CODES_JSON={"0000":{"role":"admin","displayName":"Example Admin","canManageRoster":true,"canManageBlackouts":true}}
ATTENDANCE_SESSION_SECRET=replace-with-a-long-random-secret

# Netlify Blobs is suitable for isolated/local and single-writer testing only.
# Use "supabase" for a multi-user deployment; Blobs is last-write-wins and does
# not provide the concurrency guarantees required by shared attendance edits.
ATTENDANCE_STATE_BACKEND=blobs
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=replace-with-a-server-only-secret
SUPABASE_DISTRICT_SLUG=warren-township

# Optional public link to the separate All Star Performance Tracker. Leave
# unset until Liz provides and approves the destination URL.
VITE_ALL_STAR_TRACKER_URL=
VITE_PROFESSIONAL_STANDARDS_URL=
